 </>:kind==='modules'?<>
  <g class="mini-depth"><rect x="84" y="8" width="130" height="68" rx="10"/><rect x="18" y="75" width="130" height="68" rx="10"/></g>
  <path class="mini-route" d="M157 67V110H136M84 113H71V44H101"/>
  <rect class="mini-glass" x="92" y="16" width="130" height="68" rx="10" fill={`url(#${id}-glass)`}/>
  <path d="M98 36H216"/><g class="mini-text"><rect x="110" y="25" width="26" height="5" rx="2.5"/><rect x="109" y="47" width="44" height="6" rx="3"/><rect x="109" y="60" width="36" height="5" rx="2.5"/></g>
  <rect class="mini-screen" x="165" y="44" width="39" height="25" rx="4"/>
  <rect class="mini-glass" x="10" y="67" width="130" height="68" rx="10" fill={`url(#${id}-glass)`}/>
  <path d="M16 87H134M57 87V129"/><g class="mini-text"><rect x="26" y="77" width="21" height="5" rx="2.5"/><rect x="27" y="96" width="18" height="5" rx="2"/><rect x="27" y="109" width="15" height="5" rx="2"/><rect x="67" y="97" width="52" height="6" rx="3"/><rect x="67" y="109" width="39" height="5" rx="2.5"/><rect x="67" y="120" width="47" height="5" rx="2.5"/></g>
  <circle class="mini-port" cx="157" cy="110" r="4"/><circle class="mini-port" cx="71" cy="44" r="4"/>
 </>:<>
  <g class="mini-depth"><rect x="22" y="7" width="193" height="65" rx="10"/><rect x="22" y="85" width="118" height="33" rx="8"/></g>
  <rect class="mini-glass" x="16" y="15" width="193" height="65" rx="10" fill={`url(#${id}-glass)`}/>
