---
const {kind}=Astro.props;
const id=`feature-${kind}`;
---
<div class="feature-illustration"><img class="feature-precision fx-v2" src={`/images/frontx-soft-support/small-${kind}.png`} width="720" height="480" alt="" loading="lazy"/><svg class={`feature-graphic fx-v1 feature-${kind}`} viewBox="0 0 240 156" aria-hidden="true">
 <defs><linearGradient id={`${id}-glass`} x1="0" y1="0" x2="0" y2="1"><stop stop-color="#f8fbff" stop-opacity=".95"/><stop offset="1" stop-color="#cbdfff" stop-opacity=".35"/></linearGradient></defs>
 {kind==='shell'?<>
  <g class="mini-depth"><rect x="30" y="12" width="180" height="124" rx="14"/><path d="M24 20L30 12M204 144L210 136"/></g>
  <rect class="mini-glass" x="24" y="20" width="180" height="124" rx="14" fill={`url(#${id}-glass)`}/>
  <path d="M30 50H198M66 50V138"/>
  <rect class="mini-strong" x="39" y="63" width="18" height="14" rx="4"/>
  <g class="mini-text"><rect x="40" y="87" width="15" height="5" rx="2"/><rect x="40" y="99" width="15" height="5" rx="2"/><rect x="40" y="111" width="10" height="5" rx="2"/><rect x="42" y="35" width="57" height="6" rx="3"/><rect x="170" y="35" width="14" height="6" rx="3"/></g>
