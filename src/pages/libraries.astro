---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActionLink from '../site/ActionLink';
import {repos,coreRef} from '../site/content';
const libraries=[{name:'UI Kit',path:'ui-kit',description:'React components and shared visual tokens. Use independently, or choose your own visual layer.'},{name:'MFE runtime',path:'mfes',description:'Registration, loading and host communication for independent UI units.'},{name:'API services',path:'api',description:'Communication protocols and a service registry.'},{name:'GTS provider',path:'gts-plugin',description:'Typed definitions and validation for runtime extensions.'}];
---
<SiteLayout title="Libraries · FrontX" section="libraries"><div class="site-container"><header class="page-intro"><p class="eyebrow">FRONTX / LIBRARIES</p><h1>Use the parts you need.</h1><p>Bring individual capabilities into your application. UI Kit is one library in FrontX; it is not required to use the rest.</p></header><div class="page-content"><div class="guide-grid">{libraries.map(lib=><article class="guide-card"><p class="repo-path">@gears-frontx/{lib.path}</p><h2>{lib.name}</h2><p>{lib.description}</p><div class="page-links">{lib.path==='ui-kit'&&<ActionLink href="/showcase/?page=gallery" primary>Open UI Kit</ActionLink>}<ActionLink href={`${repos.frontx}/tree/${coreRef}/packages/${lib.path}`} external>View source</ActionLink></div></article>)}</div><p class="fine-print">Library descriptions reflect a pinned development revision. The Showcase uses UI Kit 0.4.0-alpha.5; some examples are local compositions.</p></div></div></SiteLayout>
