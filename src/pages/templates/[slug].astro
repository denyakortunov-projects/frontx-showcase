---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ActionLink from '../../site/ActionLink';
import {templates,manifestUrl,repos,templateRef} from '../../site/content';
import TemplateExplorer from '../../site/TemplateExplorer';
import sourceSnapshot from '../../site/data/template-files.json';
import {Check,ArrowLeft} from 'lucide-react';
export function getStaticPaths(){return templates.map(t=>({params:{slug:t.slug},props:{template:t}}))}
const {template:t}=Astro.props;
---
<SiteLayout title={`${t.name} · FrontX templates`} section="templates"><div class="site-container"><header class="page-intro"><a class="text-link" href="/templates/"><ArrowLeft size={14}/> All templates</a><h1>{t.name}</h1><p>{t.detail}</p></header><TemplateExplorer client:load files={sourceSnapshot.templates[t.slug as keyof typeof sourceSnapshot.templates]} slug={t.slug} revision={templateRef}/><div class="page-content detail-layout"><section><ul class="included-list">{t.includes.map(item=><li><Check/>{item}</li>)}</ul><div class="page-links"><ActionLink href={manifestUrl(t.path)} primary external>View manifest</ActionLink><ActionLink href={`${repos.templates}/tree/${templateRef}/${t.path}`} external>Explore source</ActionLink></div><details class="source-disclosure"><summary>About this source snapshot</summary><p>Inspected at revision <code>{templateRef.slice(0,8)}</code>. The version below comes from the template manifest. {t.slug === "guardrails" ? "This template has been source-inspected only; its installation is not part of the Shell + MFE check." : "This revision passed the local Shell + MFE build, type-check and two-screen browser check. See Get started for exact commands and limits."}</p></details></section><aside class="detail-panel"><h2>Before you start</h2><dl><dt>Template type</dt><dd>{t.type}</dd><dt>Requires</dt><dd>{t.requires}</dd><dt>Source version</dt><dd>{t.version}</dd></dl><ActionLink href={t.slug === "guardrails" ? "/get-started/#other-paths" : `/get-started/#${t.slug === "shell" ? "prepare" : "assemble"}`}>{t.slug === "guardrails" ? "Other starting paths" : "Run Shell + MFE"}</ActionLink>{t.slug === "mfe" && <div class="page-links"><ActionLink href="/docs/first-change/">Make your first change</ActionLink></div>}</aside></div></div></SiteLayout>
