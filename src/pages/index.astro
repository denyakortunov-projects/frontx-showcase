---
import ChangeWalkthrough from '../site/ChangeWalkthrough.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ActionLink from '../site/ActionLink';
import BlueprintScene from '../site/BlueprintScene';
import ReliefScene from '../site/ReliefScene';
import PartsDiagram from '../site/PartsDiagram.astro';
import UIKitPlayground from '../site/UIKitPlayground';
import ComparisonMetrics from '../site/ComparisonMetrics';
import ClosingArt from '../site/ClosingArt.astro';
import {repos} from '../site/content';
import {ArrowUpRight,ArrowRight,PackageOpen,Play,FilePenLine,PanelLeft,PanelsTopLeft,Shapes} from 'lucide-react';
import '../site/directions.css';
import '../site/story.css';
const features=[{kind:'shell',icon:PanelLeft,title:'App Shell',text:'Navigation and routing, ready for your application.',href:'/templates/shell/',link:'Explore the Shell'},{kind:'modules',icon:PanelsTopLeft,title:'Screen templates',text:'A starting point for screens that connect to your application.',href:'/templates/mfe/',link:'Explore screen templates'},{kind:'kit',icon:Shapes,title:'Shared UI & conventions',text:'Reusable controls and design rules for people and coding agents.',href:'/templates/guardrails/',link:'Explore Design Guardrails'}];
---
<SiteLayout directional description="FrontX is an open-source development kit for complex web interfaces, designed for AI-assisted coding.">
<script is:inline>
const fxQuery=new URLSearchParams(location.search);if(fxQuery.has('page'))location.replace('/showcase/'+location.search+location.hash);
</script>
<section class="fx-hero" aria-labelledby="fx-title"><div class="fx-wrap fx-hero-layout"><h1 id="fx-title">Build complex apps.<br/>With a shared foundation.</h1><div class="fx-intro"><p>FrontX is an open-source development kit for complex web interfaces, designed for AI-assisted coding.</p><div class="fx-actions"><ActionLink href="/get-started/" primary>Get started</ActionLink><a class="fx-text-link" href={repos.frontx}>View on GitHub<ArrowUpRight size={17}/></a></div></div><div class="fx-hero-art"><div class="fx-v1"><BlueprintScene client:load/></div><div class="fx-v2"><ReliefScene client:load/></div></div></div></section>
<section class="fx-foundation fx-wrap" id="why"><div class="fx-section-heading"><h2>The groundwork, already connected.</h2></div><div class="fx-foundation-grid">{features.map(f=><article class={`foundation-item tone-${f.kind}`}><span class="foundation-icon"><f.icon size={25} strokeWidth={1.6}/></span><h3>{f.title}</h3><p>{f.text}</p><a href={f.href} class="fx-text-link">{f.link}<ArrowRight size={16}/></a></article>)}</div></section>
<PartsDiagram/>
<ChangeWalkthrough/>
<section class="fx-ui-section fx-wrap" id="ui-kit"><div class="fx-ui-intro"><div><span class="fx-section-label">FrontX UI Kit</span><h2>One visual language.<br/>Every interaction.</h2></div><div><p>A shared vocabulary for your interfaces. Explore the components, then use them in your application.</p><a href="/showcase/?page=overview" class="fx-text-link">Explore UI Kit<ArrowUpRight size={17}/></a></div></div><div class="fx-ui-stage"><UIKitPlayground client:visible/></div></section>
<section class="fx-comparison" id="benefits" aria-labelledby="comparison-title"><div class="fx-wrap"><div class="fx-section-heading"><h2 id="comparison-title">Your AI agent.<br/>With a ready-made foundation.</h2><p>AI helps you code in both cases. The difference is what you start with.</p></div><ComparisonMetrics client:load/></div></section>
<section class="fx-start fx-wrap" id="start"><div><h2>A running app.<br/>Then your first change.</h2><p>Install the templates, run Shell + MFE and make your first change.</p><a class="fx-text-link fx-first-look" href="/templates/mfe/?view=example">See the example first<ArrowUpRight size={16}/></a></div><ol class="fx-steps"><li><a href="/get-started/#install"><span class="fx-step-graphic" aria-hidden="true"><PackageOpen size={27} strokeWidth={1.5}/></span><div><h3>Install & assemble</h3><p>Set up the Shell and its MFE workspace.</p></div><ArrowUpRight size={19}/></a></li><li><a href="/get-started/#run"><span class="fx-step-graphic" aria-hidden="true"><Play size={27} strokeWidth={1.5}/></span><div><h3>Run it locally</h3><p>Open the included example screens.</p></div><ArrowUpRight size={19}/></a></li><li><a href="/docs/first-change/"><span class="fx-step-graphic" aria-hidden="true"><FilePenLine size={27} strokeWidth={1.5}/></span><div><h3>Make your first change</h3><p>Edit a screen and see it in the running application.</p></div><ArrowUpRight size={19}/></a></li></ol></section>
<section class="fx-end"><ClosingArt/><div class="fx-wrap"><h2>Build your next app<br/>on FrontX.</h2><div><ActionLink href="/get-started/" primary>Get started</ActionLink><a href={repos.frontx} class="fx-text-link">Explore the source<ArrowUpRight size={20}/></a></div></div></section>

</SiteLayout>
