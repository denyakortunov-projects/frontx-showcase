---
import SiteLayout from '../layouts/SiteLayout.astro';
import AssemblyDiagram from '../site/AssemblyDiagram';
import ActionLink from '../site/ActionLink';
import {repos,templates} from '../site/content';
import {ArrowUpRight, ArrowRight, PanelsTopLeft, Layers, ScanLine, Braces, GitBranch, Component, Check} from 'lucide-react';
const icons=[PanelsTopLeft,Layers,ScanLine];
---
<SiteLayout>
<script is:inline>
// Preserve every legacy query field and fragment while replacing the entry in history.
if(new URLSearchParams(location.search).has('page')) location.replace('/showcase/'+location.search+location.hash);
</script>
<section class="site-hero site-container"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>Constructor Fabric / Gears / FrontX</p><h1>Build your frontend.<br/><span>Make it yours.</span></h1><p class="hero-description">Libraries, templates and AI tooling for frontend projects. Start with a structure you can understand, extend and own.</p><div class="hero-actions"><ActionLink href="/get-started/" primary>Get started</ActionLink><ActionLink href={repos.frontx} external>View on GitHub</ActionLink></div><div class="hero-footnote"><GitBranch size={14}/><span>Open source. Part of Constructor Fabric.</span></div></div><AssemblyDiagram client:load/></section>
<section class="ecosystem-strip"><div class="site-container"><span>One frontend Gear.<br/><strong>Three ways to work.</strong></span><a href="/templates/"><PanelsTopLeft size={21}/><div><strong>Start with a template</strong><small>Give your project a foundation</small></div><ArrowUpRight size={17}/></a><a href="/libraries/"><Braces size={21}/><div><strong>Use a library</strong><small>Add only what you need</small></div><ArrowUpRight size={17}/></a><a href="/get-started/#ai"><GitBranch size={21}/><div><strong>Build with an agent</strong><small>Guide the work. Review the changes.</small></div><ArrowUpRight size={17}/></a></div></section>
<section class="site-section site-container"><div class="section-heading"><div><p class="eyebrow">PROJECT FOUNDATIONS</p><h2>Give your next idea<br/>a place to start.</h2></div><a class="text-link" href="/templates/">All templates <ArrowRight size={16}/></a></div><div class="template-grid">{templates.map((t,i)=>{const Icon=icons[i];return <a class={`template-card template-${t.slug}`} href={`/templates/${t.slug}/`}><div class="template-art" aria-hidden="true"><Icon size={56} strokeWidth={1.2}/><span class="art-rule one"></span><span class="art-rule two"></span></div><div class="template-body"><span class="card-category">{t.type}</span><h3>{t.name}<ArrowUpRight size={18}/></h3><p>{t.description}</p></div></a>})}</div></section>
<section class="kit-section"><div class="site-container kit-layout"><div><p class="eyebrow">LIBRARIES / UI KIT</p><h2>A visual language.<br/><span class="muted-heading">Room for your own.</span></h2><p class="section-description">Use FrontX components on their own, or bring your own UI. Explore the existing themes, charts and calendars.</p><ActionLink href="/showcase/?page=gallery" primary>Open UI Kit</ActionLink><p class="fine-print">Standalone interactive examples · synthetic data</p></div><div class="kit-destinations"><a href="/showcase/?page=gallery"><span class="kit-number">01</span><div><h3>Charts & widgets</h3><p>18 data-driven examples</p></div><ArrowUpRight/></a><a href="/showcase/?page=event-calendar"><span class="kit-number">02</span><div><h3>Event calendar</h3><p>Day, week, month and year</p></div><ArrowUpRight/></a><a href="/showcase/?page=date-picker"><span class="kit-number">03</span><div><h3>Date picker</h3><p>Single dates and ranges</p></div><ArrowUpRight/></a></div></div></section>
<section class="site-section site-container open-source-section"><div><p class="eyebrow">READ IT. USE IT. CONTRIBUTE.</p><h2>The next step<br/>is in the source.</h2><p class="section-description">Explore the code behind FrontX and the templates that bring projects together.</p></div><div class="source-paths"><a href={repos.frontx}><Braces/><div><strong>FrontX</strong><small>Libraries, CLI and AI tooling</small></div><ArrowUpRight/></a><a href={repos.templates}><Layers/><div><strong>FrontX templates</strong><small>Project foundations and rules</small></div><ArrowUpRight/></a><a href={repos.fabric}><Component/><div><strong>Constructor Fabric</strong><small>Explore the wider ecosystem</small></div><ArrowUpRight/></a></div></section>
</SiteLayout>
