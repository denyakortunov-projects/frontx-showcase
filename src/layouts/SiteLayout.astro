---
import '@gears-frontx/ui-kit/theme.css';
import {siteMetadata, defaultDescription} from '../../scripts/site-metadata.mjs';
import '../site/tokens.css';
import '../site/site.css';
import '../site/chrome.css';
import {ArrowUpRight} from 'lucide-react';
import ActionLink from '../site/ActionLink';
import SiteHeader from '../site/SiteHeader';
import SiteFooter from '../site/SiteFooter';
import '../site/directions.css';
import '../site/interior.css';
import '../site/journey.css';
import '../site/graphic-motifs.css';
import {repos} from '../site/content';
const {title='FrontX · Constructor Fabric',description=defaultDescription,section='',directional=false}=Astro.props;
---
<!doctype html><html lang="en" data-theme="light" data-frontx-version="2"><head><link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><Fragment set:html={siteMetadata({title,description,pathname:Astro.url.pathname})}/><title>{title}</title></head>
<script is:inline>try{const v=new URLSearchParams(location.search).get('v');document.documentElement.dataset.frontxVersion=v==='1'?'1':'2';}catch{document.documentElement.dataset.frontxVersion='2';}</script><body class:list={['frontx-site',{'fx-page':directional}]}><a class="site-skip" href="#content">Skip to content</a>
<SiteHeader section={section}/>
<main id="content"><slot/></main>
<SiteFooter/>
<script>import {initSiteNavigation} from '../site/navigation';initSiteNavigation();
import {initGuidePosition} from '../site/guide-position';initGuidePosition();</script>
</body></html>
